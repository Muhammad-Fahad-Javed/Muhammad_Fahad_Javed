# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (see README for setup)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT auth for the admin dashboard
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin login (used only once, to seed the first admin user — see config/seed.js)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me_now

# Email (for contact form notifications) — using Gmail SMTP as an example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_EMAIL=you@example.com

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://muhammadfahadjaved.vercel.app
