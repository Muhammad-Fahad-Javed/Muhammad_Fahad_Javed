// ============================================================================
// Portfolio CMS — Prisma schema
//
// Provider is PostgreSQL by default because that is what works reliably with
// Vercel Serverless Functions (the filesystem there is read-only/ephemeral,
// so SQLite cannot be used in production). For local development you can
// either point DATABASE_URL at a free Neon/Vercel Postgres branch, or run
// Postgres in Docker. See README.md → "Local development" for both options.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  // Bumped whenever every session for this user must be invalidated
  // (password change, forced logout). Checked on every authenticated request.
  sessionVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
}

// Revocable sessions. A JWT is only accepted while its row still exists, has
// not expired, and the user's sessionVersion still matches the token.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  // Normalised account identifier (email) so throttling also works when the
  // client IP cannot be trusted / is rotated.
  identifier String   @default("")
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ip, createdAt])
  @@index([identifier, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AUDIT TRAIL
// ---------------------------------------------------------------------------

// Records important administrator actions. Deliberately stores no payload
// bodies (only a short, non-sensitive meta string).
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String   @default("")
  action     String
  resource   String   @default("")
  resourceId String   @default("")
  ip         String   @default("")
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([resource, createdAt])
}

// ---------------------------------------------------------------------------
// SINGLETONS (one row each, id is always "singleton")
