  order     Int      @default(0)
  visible   Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  shortDesc    String   @default("")
  fullDesc     String   @default("")
  image        String   @default("")
  images       String   @default("[]") // JSON array of urls
  technologies String   @default("[]") // JSON array of strings
  category     String   @default("")
  githubUrl    String   @default("")
  liveUrl      String   @default("")
  date         String   @default("")
  client       String   @default("")
  features     String   @default("[]")
  role         String   @default("")
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  order        Int      @default(0)
  // The featured-projects allowlist: a repo is only ever synced into a project
  // that already names it here. Empty means "manual project, leave it alone".
  githubRepo    String    @default("")
  // Repository timestamp reported by GitHub. Internal metadata only; it is not
  // in the public registry, so it is never published.
  repoUpdatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

