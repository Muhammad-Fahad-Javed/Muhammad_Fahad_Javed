# Copy this file to .env for local development, and set the same values as
# Environment Variables in your Vercel project settings for production.

# PostgreSQL connection string. Free options: Neon (neon.tech), Vercel Postgres,
# or Supabase. Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Long random string used to sign admin login sessions (JWT).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Used once by `npm run seed` and `npm run create-admin` to create your admin
# login. You can change the password later from the dashboard's My Account page.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-something-strong

# Optional but required for image uploads to work in production (Vercel's
# filesystem is read-only). Create a Blob store in your Vercel project's
# Storage tab and it will provide this automatically.
BLOB_READ_WRITE_TOKEN=
