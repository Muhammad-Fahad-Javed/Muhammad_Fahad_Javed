{
  "name": "fahad-javed-portfolio-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site (static frontend) + Admin Dashboard / CMS backend (Vercel serverless functions + Prisma).",
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "node scripts/local-dev/run.js",
    "dev:local:setup": "node scripts/local-dev/setup.js",
    "dev:local:reset": "node scripts/local-dev/setup.js --reset",
    "build": "prisma generate && node scripts/prepare-build.js",
    "start": "vercel dev",
    "postinstall": "prisma generate",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:registry": "node scripts/generate-client-registry.js --check",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "admin:create": "node scripts/create-admin.js --create",
    "admin:reset-password": "node scripts/create-admin.js --reset-password",
    "registry:build": "node scripts/generate-client-registry.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": "22.x"
  }
}
